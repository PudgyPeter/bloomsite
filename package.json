{
  "name": "bloom-band-website",
  "version": "0.1.0",
  "description": "Official website for Bloom - melodic hardcore band from Sydney, Australia",
  "author": "Bloom Band <booking@bloomband.com.au>",
  "license": "MIT",
  "keywords": [
    "melodic-hardcore",
    "metalcore",
    "Sydney-band",
    "Australian-rock"
  ],
  "repository": {
    "type": "git",
    "url": ""
  },
  "scripts": {
    "start": "python -m http.server 8000",
    "watch-css": "watchmedo shell-command --recursive --drop --wait \"npm run minify-css\" --glob \"*.css\"",
    "minify-css": "cssnano assets/styles.css assets/temp.min.css",
    "lint": "eslint --config assets/.eslintrc.json assets/script.js",
    "format": "prettier --config assets/.prettierrc.json --write \"*.html\" \"assets/*.js\" \"assets/*.css\"",
    "format:check": "prettier --config assets/.prettierrc.json --check \"*.html\" \"assets/*.js\" \"assets/*.css\""
  },
  "devDependencies": {
    "cssnano-cli": "^1.0.5",
    "eslint": "^8.57.1",
    "prettier": "^3.6.2"
  }
}
