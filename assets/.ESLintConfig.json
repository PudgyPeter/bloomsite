{
  "env": {
    "browser": true,
    "es6": true
  },
  "parserOptions": {
    "ecmaVersion": 5,
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "args": "none" }],
    "eqeqeq": "error",
    "curly": "error",
    "semi": "error",
    "indent": ["error", 4],
    "quotes": ["error", "single"]
  }
}
