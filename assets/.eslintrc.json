{
  "env": {
    "browser": true,
    "es6": true
  },
  "parserOptions": {
    "ecmaVersion": 5
  },
  "rules": {
    "no-unused-vars": ["warn", { "args": "none" }],
    "eqeqeq": "error",
    "curly": ["error", "multi-line"],
    "semi": "error",
    "indent": ["error", 2],
    "quotes": ["error", "double", { "avoidEscape": true }]
  }
}
